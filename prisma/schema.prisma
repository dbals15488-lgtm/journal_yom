// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL") 
}

model Record {
  id        Int      @id @default(autoincrement())
  title     String
  content   String 
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fileUrl   String[]
  userId    Int      
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Record")
  @@index([userId, createdAt])
}

model WorkoutRecord {
  id          Int      @id @default(autoincrement())
  date        DateTime
  part        String   
  workoutName String
  reps        Int
  sets        Int
  restTime    String   
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model DietRecord {
  id          Int      @id @default(autoincrement())
  date        DateTime
  foodName    String   // 음식명 (예: "닭가슴살")
  amount      String   // 양 (예: "100g", "1개")
  protein     Float    // 단백질 (g)
  fat         Float    // 지방 (g)
  carbs       Float    // 탄수화물 (g)
  calories    Float    // 칼로리 (kcal)
  mealType    String   // 식사 구분 ("아침"/"점심"/"저녁"/"간식")
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

model AiChat {
  id        Int      @id @default(autoincrement())
  role      String   // "user" or "assistant"
  content   String   @db.Text  // 긴 텍스트 저장 가능
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model User {
  id        Int      @id @default(autoincrement()) 
  userId    String   @unique                       
  name      String                                 
  email     String   @unique                       
  password  String                                 
  role      String   @default("user")   
  createdAt DateTime @default(now())     

  records         Record[]
  workoutRecords  WorkoutRecord[]
  dietRecords     DietRecord[]
  aiChats         AiChat[]
  supportPosts    SupportPost[]      
}

model SupportPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  category  String   // "bug" / "improvement" / "question"
  status    String   @default("pending") // "pending" / "answered" / "closed"
  answer    String?  @db.Text            // 관리자 답변 (선택)
  answeredAt DateTime?                    // 답변 시각
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}